# `git clone` gives everything: source, tests and the build in lib/.
# "Download ZIP" and the source archives of a release use `git archive`, which skips every export-ignore path,
# so they contain only what the add-on needs to run: lib/, php/, package.json, icon.svg and the docs.
/src                        export-ignore
/tests                      export-ignore
/scripts                    export-ignore
/.github                    export-ignore
/.githooks                  export-ignore
/.editorconfig              export-ignore
/.gitattributes             export-ignore
/.gitignore                 export-ignore
/.nvmrc                     export-ignore
/biome.json                 export-ignore
/tsconfig.json              export-ignore
/vitest.config.ts           export-ignore
/vitest.integration.config.ts export-ignore
/package-lock.json          export-ignore
/DEVELOPMENT.md             export-ignore
/CONTRIBUTING.md            export-ignore
/docs                       export-ignore

# The build is generated. Hide it from diffs and language stats.
/lib/** linguist-generated=true -diff
